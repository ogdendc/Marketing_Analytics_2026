      <column caption='Campaign ID' datatype='string' name='[campaign_id]' role='dimension' type='nominal' />
      <column caption='Campaign Name' datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
      <column caption='Channel' datatype='string' name='[channel]' role='dimension' type='nominal' />
      <column caption='Objective' datatype='string' name='[objective]' role='dimension' type='nominal' />
      <column caption='Household ID' datatype='string' name='[household_id]' role='dimension' type='nominal' />
      <column caption='Audience Group' datatype='string' name='[audience_group]' role='dimension' type='nominal' />
      <column caption='Segment' datatype='string' name='[segment]' role='dimension' type='nominal' />
      <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
      <column caption='Preferred Channel' datatype='string' name='[preferred_channel]' role='dimension' type='nominal' />
      <column caption='Household AUM' datatype='integer' name='[household_aum]' role='measure' type='quantitative' />
      <column caption='AUM Band' datatype='string' name='[aum_band]' role='dimension' type='nominal' />
      <column caption='Engagement Score' datatype='integer' name='[engagement_score]' role='measure' type='quantitative' />
      <column caption='Engagement Band' datatype='string' name='[engagement_band]' role='dimension' type='nominal' />
      <column caption='Advisor ID' datatype='string' name='[advisor_id]' role='dimension' type='nominal' />
      <column caption='Send Date' datatype='date' name='[send_date]' role='dimension' type='ordinal' />
      <column caption='Delivered' datatype='integer' name='[delivered]' role='measure' type='quantitative' />
      <column caption='Opened' datatype='integer' name='[opened]' role='measure' type='quantitative' />
      <column caption='Clicked' datatype='integer' name='[clicked]' role='measure' type='quantitative' />
      <column caption='Responded' datatype='integer' name='[responded]' role='measure' type='quantitative' />
      <column caption='Converted' datatype='integer' name='[converted]' role='measure' type='quantitative' />
      <column caption='Conversion Value' datatype='real' name='[conversion_value]' role='measure' type='quantitative' />
      <column caption='Contact Cost' datatype='real' name='[contact_cost]' role='measure' type='quantitative' />
      <column caption='Contacts' datatype='integer' name='[Calculation_Contacts]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([household_id])' />
      </column>
      <column caption='Conversions' datatype='integer' name='[Calculation_Conversions]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted])' />
      </column>
      <column caption='Conversion Rate' datatype='real' name='[Calculation_ConversionRate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([converted])/COUNT([household_id])' />
      </column>
      <column caption='Net Value' datatype='real' name='[Calculation_NetValue]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([conversion_value]) - SUM([contact_cost])' />
      </column>
      <column caption='Cost per Conversion' datatype='real' name='[Calculation_CostPerConv]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([contact_cost]) / SUM([converted])' />
      </column>
      <column caption='Open Rate' datatype='real' name='[Calculation_OpenRate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([opened]) / COUNT([opened])' />
      </column>
      <column caption='Target vs Holdout Lift' datatype='real' name='[Calculation_TargetLift]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([audience_group] = &apos;Target&apos;, [converted], 0)) / SUM(IIF([audience_group] = &apos;Target&apos;, 1, 0)) - SUM(IIF([audience_group] = &apos;Holdout&apos;, [converted], 0)) / SUM(IIF([audience_group] = &apos;Holdout&apos;, 1, 0))' />
      </column>
      <column caption='Campaign Conversion Rate (FIXED)' datatype='real' name='[Calculation_CampaignCVR]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [campaign_name] : SUM([converted]) / COUNT([household_id])}' />
      </column>
      <column caption='Send Week' datatype='date' name='[Calculation_SendWeek]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [send_date])' />
      </column>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPI Contacts'>
      <table>
        <view>
          <datasources>
            <datasource caption='campaign_results_detail (Databricks)' name='databricks.campaign_results_detail' />
          </datasources>
          <datasource-dependencies datasource='databricks.campaign_results_detail'>
            <column datatype='integer' name='[Calculation_Contacts]' role='measure' type='quantitative' />
            <column datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
            <column datatype='string' name='[region]' role='dimension' type='nominal' />
            <column datatype='string' name='[audience_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_Contacts]' derivation='None' name='[none:Calculation_Contacts:qk]' pivot='key' type='quantitative' />
            <column-instance column='[campaign_name]' derivation='None' name='[none:campaign_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column-instance column='[audience_group]' derivation='None' name='[none:audience_group:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[databricks.campaign_results_detail].[none:campaign_name:nk]'>
            <groupfilter function='level-members' level='[none:campaign_name:nk]' />
          </filter>
          <filter class='categorical' column='[databricks.campaign_results_detail].[none:region:nk]'>
            <groupfilter function='level-members' level='[none:region:nk]' />
          </filter>
          <filter class='categorical' column='[databricks.campaign_results_detail].[none:audience_group:nk]'>
            <groupfilter function='member' level='[none:audience_group:nk]' member='&quot;Target&quot;' />
          </filter>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
          <encodings>
            <text column='[databricks.campaign_results_detail].[none:Calculation_Contacts:qk]' />
          </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols>[databricks.campaign_results_detail].[none:Calculation_Contacts:qk]</cols>
      </table>
    </worksheet>
