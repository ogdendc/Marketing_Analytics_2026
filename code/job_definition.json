{
  "_comment": "Importable Job that orchestrates the SQL curation as sequential SQL File tasks, then refreshes the dashboard. Replace <WAREHOUSE_ID>, the file paths (workspace or Git-folder paths to this repo's code/ files), and <DASHBOARD_ID>. Create via: Workflows > Create Job, or `databricks jobs create --json @job_definition.json`.",
  "name": "marketing_analytics_curation",
  "tasks": [
    {
      "task_key": "curate_silver",
      "sql_task": {
        "file": { "path": "/Workspace/Repos/Marketing_Analytics_2026/code/01_curate_silver.sql", "source": "WORKSPACE" },
        "warehouse_id": "<WAREHOUSE_ID>"
      }
    },
    {
      "task_key": "curate_gold",
      "depends_on": [ { "task_key": "curate_silver" } ],
      "sql_task": {
        "file": { "path": "/Workspace/Repos/Marketing_Analytics_2026/code/02_curate_gold.sql", "source": "WORKSPACE" },
        "warehouse_id": "<WAREHOUSE_ID>"
      }
    },
    {
      "task_key": "refresh_metric_view",
      "depends_on": [ { "task_key": "curate_gold" } ],
      "sql_task": {
        "file": { "path": "/Workspace/Repos/Marketing_Analytics_2026/code/03_metric_view.sql", "source": "WORKSPACE" },
        "warehouse_id": "<WAREHOUSE_ID>"
      }
    },
    {
      "task_key": "refresh_dashboard",
      "depends_on": [ { "task_key": "refresh_metric_view" } ],
      "dashboard_task": {
        "dashboard_id": "<DASHBOARD_ID>",
        "warehouse_id": "<WAREHOUSE_ID>"
      }
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "America/Chicago",
    "pause_status": "PAUSED"
  },
  "queue": { "enabled": true }
}
